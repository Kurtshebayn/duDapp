# duDapp -- Backend environment variables
# Copy this file to .env and fill in the values.
# Never commit .env to git.

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/dudapp

# JWT signing secret -- REQUIRED, must be >= 32 chars, no insecure defaults.
# Generate a strong secret with:
#   openssl rand -hex 32
JWT_SECRET=

# Comma-separated list of allowed CORS origins (no trailing comma).
# Example: https://your-frontend.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Admin bootstrap (used by scripts/crear_admin.py -- remove after first deploy)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Cloudinary (optional -- required for player photo upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
